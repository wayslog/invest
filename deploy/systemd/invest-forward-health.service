[Unit]
Description=Invest independent heartbeat and backup watchdog
Wants=network-online.target
After=network-online.target
OnFailure=invest-forward-failure.service

[Service]
Type=oneshot
User=invest
Group=invest
WorkingDirectory=/opt/invest/current
EnvironmentFile=/etc/invest/invest.env
Environment=MPLCONFIGDIR=/var/lib/invest/cache/matplotlib
ExecStart=/opt/invest/current/.venv/bin/invest forward-health --config /etc/invest/operations.toml
TimeoutStartSec=2min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/invest
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
